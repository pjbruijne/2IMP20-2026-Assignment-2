bouldering_wall "Test wall" {
  routes [
    bouldering_route "r1" {
      grade: "5A",
      grid_base_point { x: 0, y: 0 },
      holds ["0001", "0002"]
    }
  ],
  volumes [
    circle {
      pos: { x: 50, y: 200 },
      depth: -10,
      radius: 50,
      front_holds [
        hold "0001" { pos: { x: 2, y: 20 }, shape: "5", colours [ white ], start_hold: 1 },
        hold "0002" { pos: { x: 3, y: 21 }, shape: "5", colours [ white ], end_hold }
      ]
    }
  ]
}